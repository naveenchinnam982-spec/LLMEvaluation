<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/promptFragment">

    <fragment
        android:id="@+id/promptFragment"
        android:name="project.llmevaluation.ui.PromptFragment"
        android:label="Prompt"
        tools:layout="@layout/fragment_prompt">
        <action
            android:id="@+id/action_promptFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="project.llmevaluation.ui.ResultFragment"
        android:label="Evaluation Results"
        tools:layout="@layout/fragment_result" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="project.llmevaluation.ui.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="project.llmevaluation.ui.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_aboutFragment"
            app:destination="@id/aboutFragment" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="project.llmevaluation.ui.AboutFragment"
        android:label="About"
        tools:layout="@layout/fragment_about" />
</navigation>
